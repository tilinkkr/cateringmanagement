# Copy this file to "config.env" and fill in ONE provider, then choose it in Settings > WhatsApp sending.
# Never share config.env - it contains your account keys.

# ---- Meta WhatsApp Cloud API (developers.facebook.com > WhatsApp) ----
# WA_META_TOKEN=EAAG...
# WA_META_PHONE_NUMBER_ID=1234567890
# Approved message template with two body variables, e.g. "Hello {{1}}, {{2}}"
# WA_META_TEMPLATE=catering_reminder
# WA_META_TEMPLATE_LANG=en

# ---- Twilio WhatsApp ----
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
